# MongoDB Connection - Use MongoDB Atlas (cloud) for production
# Get your connection string from: https://mongodb.com/cloud/atlas
# Format: mongodb+srv://username:password@cluster.mongodb.net/dbname?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://your_username:your_password@your_cluster.mongodb.net/my-projet?retryWrites=true&w=majority

# JWT Secret for token signing
JWT_SECRET=your_secret_key_here

# Environment
NODE_ENV=production

# Port
PORT=5000

# CORS Origins (add your frontend URLs here)
CORS_ORIGIN=https://blog-web-theta-one.vercel.app
FRONTEND_ORIGIN=https://blog-web-theta-one.vercel.app
