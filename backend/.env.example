# ============================================
# MongoDB Configuration
# ============================================
# For LOCAL development:
# MONGO_URI=mongodb://127.0.0.1:27017/my-projet
# 
# For PRODUCTION (Vercel):
# Get from MongoDB Atlas: https://mongodb.com/cloud/atlas
# MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/my-projet?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/my-projet

# ============================================
# JWT Configuration
# ============================================
JWT_SECRET=your_super_secret_key_change_me_in_production

# ============================================
# Server Configuration
# ============================================
PORT=4025
NODE_ENV=development

# ============================================
# CORS Configuration
# ============================================
# Frontend URLs allowed to make requests
CORS_ORIGIN=https://blog-web-theta-one.vercel.app
FRONTEND_ORIGIN=https://blog-web-theta-one.vercel.app

# ============================================
# For Local Development
# ============================================
# Make sure MongoDB is running locally:
# mongod
