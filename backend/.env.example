# MongoDB Connection
MONGO_URI=your_mongodb_connection_string

# JWT Secret for token signing
JWT_SECRET=your_secret_key_here

# Environment
NODE_ENV=production

# Port
PORT=5000

# CORS Origins (add your frontend URLs here)
CORS_ORIGIN=https://blog-web-theta-one.vercel.app
FRONTEND_ORIGIN=https://blog-web-theta-one.vercel.app
